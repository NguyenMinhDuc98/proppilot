# --- LLM ---
# "offline" = built-in rule-based assistant, zero cost, no key needed.
# "anthropic" = real Claude via the Messages API (pay per token).
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# USD per million tokens, used for the cost estimate shown under each answer
LLM_PRICE_INPUT_PER_MTOK=1.00
LLM_PRICE_OUTPUT_PER_MTOK=5.00
# What a token written to and a token read from the prompt cache cost, as multiples of the input price (Anthropic bills
# 1.25 and 0.10 for the 5-minute cache). Tokens the API reports as cached are priced with these, not as plain input.
LLM_CACHE_WRITE_MULTIPLIER=1.25
LLM_CACHE_READ_MULTIPLIER=0.10
# Mark the tools, the system prompt and the conversation so far for Claude to cache, so that a later call of the same
# question and the next question read them at the cache read price. Claude caches a prefix only when it is longer than a
# minimum that depends on the model, and otherwise silently does not: the cache tokens it reports are recorded (see the
# trace) and nothing assumes a hit. false sends the requests as they were before caching.
PROMPT_CACHING=true
# Longest single model reply; an answer that hits it is cut off and flagged as truncated
LLM_MAX_TOKENS=2048
# Extra attempts after a transient failure (429, 5xx, 529, network error), with exponential backoff
LLM_MAX_RETRIES=3

# Longest a single question may run before it is stopped (the model calls and their retries share this budget)
AGENT_RUN_TIMEOUT_SECONDS=90

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/proppilot
DB_USER=proppilot
DB_PASSWORD=proppilot

# --- Web ---
# Comma separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Chat safety limits
CHAT_MAX_MESSAGE_LENGTH=500
# Most earlier messages (questions and answers together) a request may carry; the web app reads this limit from /api/info
CHAT_MAX_HISTORY_ITEMS=20
CHAT_RATE_LIMIT_PER_MINUTE=10
# Global cap on questions per day across all visitors (protects your API budget)
CHAT_DAILY_LIMIT=500

# --- Write actions ---
# The agent only proposes changes; nothing is written until a person approves it. These caps protect the shared demo data.
# Minutes a proposed change waits for a decision before it expires
ACTION_TTL_MINUTES=15
# Preview, approve and reject calls per client per minute
ACTION_DECISIONS_PER_MINUTE=30
# Global cap on approved changes per day across all visitors
ACTION_MAX_APPROVALS_PER_DAY=100
# Most changes one question may propose
ACTION_MAX_PROPOSALS_PER_RUN=3
# Global cap on proposed changes per day across all visitors
ACTION_MAX_PROPOSALS_PER_DAY=200

# --- Admin ---
# Enables these endpoints, sent with the X-Admin-Token header:
#   GET /api/admin/runs       the latest questions with model, cost and latency. Filter with status, model and
#                             guardrailFlagged; page backwards with before (the createdAt of the last run)
#   GET /api/admin/runs/{id}  one run with its question and its trace: every model call, and every tool call with its
#                             arguments and result
#   POST /api/admin/reset     restores the seeded demo data; the nightly workflow calls it
# Visitors' questions are never shown publicly: the public trace of a run (GET /api/runs/{id}/trace) holds no question,
# no answer and no tool arguments. Leave empty to switch the admin endpoints off (they answer 404).
# At least 24 characters, or the backend refuses to start. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# --- Lease documents ---
# Once the backend is up it writes a lease PDF for each of the first RAG_DOCUMENT_COUNT active leases from the
# database, reads the text back and stores it as searchable chunks, in the background. It is safe on every start (what
# exists is left alone). false skips it.
RAG_SEED_ON_STARTUP=true
# How many leases get a document. The evals, and the seven leases that end soon in the seed, assume 30
RAG_DOCUMENT_COUNT=30

# --- Embeddings (optional) ---
# "none" = lease search by keywords only, zero cost, no key needed.
# "voyage" = the chunks and each question are also embedded with Voyage AI, so a question is matched by meaning too.
# The chunks are embedded in the background after the documents are written (RAG_SEED_ON_STARTUP=false skips that
# too). A rate limit or an outage leaves them for the next start or for POST /api/admin/rag/reindex, and search keeps
# working on keywords meanwhile.
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# Must be 1024, the size of the lease_chunks.embedding column, or the backend refuses to start
EMBEDDING_DIMENSIONS=1024

# --- OpenTelemetry ---
# Off by default: nothing is created and nothing leaves the process. true exports every question as spans (one for the
# run, one for each model call and each tool call) over OTLP/HTTP. A span holds identifiers, names, counts, timings and
# outcomes; prompts, questions, answers and tool arguments are never exported.
OTEL_ENABLED=false
# The collector's OTLP/HTTP address; not empty when OTEL_ENABLED is true. Under docker compose, localhost is the backend
# container itself: use the collector's service name or host.docker.internal
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Headers the collector wants, as key=value pairs separated by commas (a hosted collector's token goes here)
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=proppilot
