# --- LLM ---
# "offline" = built-in rule-based assistant, zero cost, no key needed.
# "anthropic" = real Claude via the Messages API (pay per token).
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# USD per million tokens, used for the cost estimate shown under each answer
LLM_PRICE_INPUT_PER_MTOK=1.00
LLM_PRICE_OUTPUT_PER_MTOK=5.00
# Longest single model reply; an answer that hits it is cut off and flagged as truncated
LLM_MAX_TOKENS=2048
# Extra attempts after a transient failure (429, 5xx, 529, network error), with exponential backoff
LLM_MAX_RETRIES=3

# Longest a single question may run before it is stopped (the model calls and their retries share this budget)
AGENT_RUN_TIMEOUT_SECONDS=90

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/proppilot
DB_USER=proppilot
DB_PASSWORD=proppilot

# --- Web ---
# Comma separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Chat safety limits
CHAT_MAX_MESSAGE_LENGTH=500
# Most earlier messages (questions and answers together) a request may carry; the web app reads this limit from /api/info
CHAT_MAX_HISTORY_ITEMS=20
CHAT_RATE_LIMIT_PER_MINUTE=10
# Global cap on questions per day across all visitors (protects your API budget)
CHAT_DAILY_LIMIT=500

# --- Write actions ---
# The agent only proposes changes; nothing is written until a person approves it. These caps protect the shared demo data.
# Minutes a proposed change waits for a decision before it expires
ACTION_TTL_MINUTES=15
# Preview, approve and reject calls per client per minute
ACTION_DECISIONS_PER_MINUTE=30
# Global cap on approved changes per day across all visitors
ACTION_MAX_APPROVALS_PER_DAY=100
# Most changes one question may propose
ACTION_MAX_PROPOSALS_PER_RUN=3
# Global cap on proposed changes per day across all visitors
ACTION_MAX_PROPOSALS_PER_DAY=200

# --- Admin ---
# Enables GET /api/admin/runs (the latest questions with cost and latency) and POST /api/admin/reset (restores the
# seeded demo data; the nightly workflow calls it), sent with the X-Admin-Token header.
# Visitors' questions are never shown publicly. Leave empty to switch the admin endpoints off (they answer 404).
# At least 24 characters, or the backend refuses to start. Generate one with: openssl rand -hex 24
ADMIN_TOKEN=
