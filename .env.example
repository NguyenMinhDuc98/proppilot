# --- LLM ---
# "offline" = built-in rule-based assistant, zero cost, no key needed.
# "anthropic" = real Claude via the Messages API (pay per token).
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# USD per million tokens, used for the cost estimate shown under each answer
LLM_PRICE_INPUT_PER_MTOK=1.00
LLM_PRICE_OUTPUT_PER_MTOK=5.00
# Longest single model reply; an answer that hits it is cut off and flagged as truncated
LLM_MAX_TOKENS=2048
# Extra attempts after a transient failure (429, 5xx, 529, network error), with exponential backoff
LLM_MAX_RETRIES=3

# Longest a single question may run before it is stopped (the model calls and their retries share this budget)
AGENT_RUN_TIMEOUT_SECONDS=90

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/proppilot
DB_USER=proppilot
DB_PASSWORD=proppilot

# --- Web ---
# Comma separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Chat safety limits
CHAT_MAX_MESSAGE_LENGTH=500
CHAT_RATE_LIMIT_PER_MINUTE=10
# Global cap on questions per day across all visitors (protects your API budget)
CHAT_DAILY_LIMIT=500
